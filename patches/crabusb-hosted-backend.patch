+        assert!(checked_descriptor_bytes(&device,18,18,1,18).is_ok());
+        assert!(checked_descriptor_bytes(&device,19,18,1,18).is_err());
+        assert!(checked_descriptor_bytes(&device,8,8,1,18).is_ok());
