+/// Direct hosted entry point sharing the existing xHCI engine. Unlike the
+/// convenience Core, initialization does not discover/reset root-hub ports.
+#[cfg(feature = "hosted-direct")]
+pub struct ExplicitHost {pub(crate) core:Xhci, devices:BTreeMap<u8,xhci::Device>}
+#[cfg(feature = "hosted-direct")]
+impl ExplicitHost {
+    pub async fn configure_streams(&mut self,slot:u8,address:u8,entries:u16)->Result<()> {
+        let max=self.core.reg.read().capability.hccparams1.read_volatile().maximum_primary_stream_array_size();
+        if max==0||entries as u32>(1u32<<(max+1)){return Err(USBError::NotSupported);}
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.configure_streams(address,entries).await
+    }
+    pub fn stream_place(&mut self,slot:u8,address:u8,stream:u16,words:[u32;4])->Result<(usize,bool,u64)>{self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.stream_place(address,stream,words)}
+    pub fn stream_publish(&mut self,slot:u8,address:u8,stream:u16,index:usize,cycle:bool)->Result<()>{self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.stream_publish(address,stream,index,cycle)}
+
+    pub async fn address_route(&mut self,slot:u8,root_port:u8,speed:u8,route:u32,parent_slot:u8,parent_port:u8,multi_tt:bool,think:u8,bsr:bool)->Result<()> {
+        if !(1..=5).contains(&speed)||route>0xfffff||think>3||root_port==0||root_port>self.port_count(){return Err(USBError::InvalidParameter);}
+        let info=DeviceAddressInfo{root_port_id:root_port,parent_hub:None,port_speed:usb_if::Speed::from_xhci_portsc(speed),port_id:root_port,infos:BTreeMap::new()};
+        let mut device=self.devices.remove(&slot).ok_or(USBError::NotFound)?;
+        let result=device.address_route(&mut self.core,&info,route,parent_slot,parent_port,multi_tt,think,bsr).await;
+        self.devices.insert(slot,device);result
+    }
+    pub fn slot_context_words(&self,slot:u8)->Result<alloc::vec::Vec<u32>> {Ok(self.devices.get(&slot).ok_or(USBError::NotFound)?.slot_context_words())}
+    pub async fn configure_hub(&mut self,slot:u8,root:u8,ports:u8,multi:bool,think:u16)->Result<()> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.configure_hub(root,ports,multi,think).await
+    }
+
+    pub fn iso_schedule(&mut self,slot:u8,address:u8,asap:bool,frame:u16)->Result<()> {self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.iso_schedule(address,asap,frame)}
+    pub fn raw_events(&self,since:u64,limit:usize)->Result<alloc::vec::Vec<(u64,[u32;4])>> {
+        let log=self.core.raw_events.lock();
+        if log.front().is_some_and(|(seq,_)|since.saturating_add(1)<*seq) {return Err(USBError::Other(anyhow!("event cursor expired")));}
+        Ok(log.iter().filter(|(seq,_)|*seq>since).take(limit.min(4096)).copied().collect())
+    }
+    pub fn raw_place(&mut self,slot:u8,endpoint:u8,words:[u32;4])->Result<(usize,bool,u64)> {
+        if slot==0 {Ok(self.core.cmd.raw_place(words))} else {self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.raw_place(endpoint,words)}
+    }
+    pub fn raw_publish(&mut self,slot:u8,endpoint:u8,index:usize,cycle:bool)->Result<()> {
+        if slot==0 {self.core.cmd.raw_publish(index,cycle);Ok(())} else {self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.raw_publish(endpoint,index,cycle)}
+    }
+    /// # Safety
+    /// MMIO must cover all validated register/extended-capability spans and
+    /// outlive this owner and its sole event handler. Kernel/DMA resources must
+    /// remain alive through confirmed stop and successful unmap.
+    pub unsafe fn new(mmio:Mmio,kernel:&'static dyn KernelOp)->Result<Self> {
+        Ok(Self {core:Xhci::new(mmio,kernel)?,devices:BTreeMap::new()})
+    }
+    pub async fn initialize(&mut self)->Result<()> {self.core.init().await}
+    /// Called after confirmed reset, before DMA-fetching register programming.
+    pub async fn initialize_with_dma_hook(&mut self,before_start:impl FnOnce()->Result<()>+Send)->Result<()> {
+        self.core.init_with_dma_hook(before_start).await
+    }
+
+    pub fn port_count(&self)->u8 {self.core.reg.read().port_register_set.len() as u8}
+    /// Read only: no PORTSC W1C acknowledgment and no discovery helper.
+    pub fn port_status(&self,number:u8)->Result<u32> {
+        let reg=self.core.reg.read();
+        if number==0 || number as usize>reg.port_register_set.len() {return Err(USBError::InvalidParameter);}
+        // PORTSC is one aligned 32-bit register per 16-byte port register set.
+        // The hosted owner validated the whole port-register span before new().
+        let operational=reg.capability.caplength.read_volatile().get() as usize;
+        let ptr=(reg.mmio_base+operational+0x400+(number as usize-1)*16) as *const u32;
+        Ok(unsafe {ptr.read_volatile()})
+    }
+
+    /// Enable Slot and allocate its contexts; no USB requests are sent.
+    pub async fn enable_slot(&mut self)->Result<u8> {
+        let device=xhci::Device::new(&mut self.core).await?;
+        let slot=device.slot_number();self.devices.insert(slot,device);Ok(slot)
+    }
+    pub async fn address_device(&mut self,slot:u8,port:u8,bsr:bool)->Result<()> {
+        let status=self.port_status(port)?;
+        if status&3!=3 {return Err(USBError::InvalidParameter);}
+        let speed_code=((status>>10)&15)as u8;
+        if !(1..=5).contains(&speed_code) {return Err(USBError::NotSupported);}
+        let speed=usb_if::Speed::from_xhci_portsc(speed_code);
+        let info=DeviceAddressInfo {root_port_id:port,parent_hub:None,port_speed:speed,port_id:port,infos:BTreeMap::new()};
+        let mut device=self.devices.remove(&slot).ok_or(USBError::NotFound)?;
+        let result=device.prepare_explicit(&mut self.core,&info,bsr).await;
+        self.devices.insert(slot,device);result
+    }
+    pub fn acknowledge_port(&mut self,port:u8,changes:u32)->Result<()> {
+        if changes & !0x00fe0000 != 0 {return Err(USBError::InvalidParameter);}
+        let raw=self.port_status(port)?;
+        self.write_port(port,port_writable_state(raw)|changes);Ok(())
+    }
+    pub async fn reset_port(&mut self,port:u8,warm:bool)->Result<()> {
+        let raw=self.port_status(port)?;
+        if raw&1==0 || raw&(1<<9)==0 {return Err(USBError::InvalidParameter);}
+        if warm && ((raw>>10)&15)<4 {return Err(USBError::NotSupported);}
+        self.write_port(port,port_writable_state(raw)|if warm {1<<31}else{1<<4});
+        let mut yielded=false;
+        core::future::poll_fn(|cx| {
+            if yielded {core::task::Poll::Ready(())} else {yielded=true;cx.waker().wake_by_ref();core::task::Poll::Pending}
+        }).await;
+        loop {
+            let raw=self.port_status(port)?;
+            if raw&1==0 {return Err(USBError::NotFound);}
+            if raw&((1<<4)|(1<<31))==0 && raw&2!=0 {return Ok(());}
+            self.core.kernel.delay(core::time::Duration::from_millis(1));
+            // Yield to the outer deadline driver instead of an unbounded loop
+            // inside a single future poll.
+            struct Yield(bool);
+            impl core::future::Future for Yield {type Output=();fn poll(mut self:core::pin::Pin<&mut Self>,cx:&mut core::task::Context<'_>)->core::task::Poll<()> {if self.0 {core::task::Poll::Ready(())}else{self.0=true;cx.waker().wake_by_ref();core::task::Poll::Pending}}}
+            Yield(false).await;
+        }
+    }
+    fn write_port(&mut self,port:u8,value:u32) {
+        let reg=self.core.reg.read();
+        let op=reg.capability.caplength.read_volatile().get() as usize;
+        unsafe {((reg.mmio_base+op+0x400+(port as usize-1)*16)as *mut u32).write_volatile(value);}
+    }
