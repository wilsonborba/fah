+pub(crate) fn decode_ep0_packet_size(speed:Speed,encoded:u8)->Result<u16> {
+    let bytes=match speed {
+        Speed::Low if encoded==8 => 8,
+        Speed::Full if matches!(encoded,8|16|32|64) => encoded as u16,
+        Speed::High if encoded==64 => 64,
+        Speed::SuperSpeed|Speed::SuperSpeedPlus if encoded==9 =>512,
+        _=>return Err(usb_if::err::USBError::InvalidParameter),
+    };
+    Ok(bytes)
+}
+#[cfg(test)]
+mod ep0_descriptor_tests {
+    use super::*;
+    #[test]
+    fn descriptor_size_decoding_is_speed_specific() {
+        for encoded in [8,16,32,64] {assert_eq!(decode_ep0_packet_size(Speed::Full,encoded).unwrap(),encoded as u16);}
+        assert_eq!(decode_ep0_packet_size(Speed::Low,8).unwrap(),8);
+        assert_eq!(decode_ep0_packet_size(Speed::High,64).unwrap(),64);
+        for speed in [Speed::SuperSpeed,Speed::SuperSpeedPlus] {assert_eq!(decode_ep0_packet_size(speed,9).unwrap(),512);assert!(decode_ep0_packet_size(speed,64).is_err());}
+        for speed in [Speed::Low,Speed::Full,Speed::High,Speed::SuperSpeed,Speed::SuperSpeedPlus] {assert!(decode_ep0_packet_size(speed,0).is_err());}
+        assert!(decode_ep0_packet_size(Speed::Low,64).is_err());
+        assert!(decode_ep0_packet_size(Speed::High,8).is_err());
+    }
+}
