+fn checked_configuration_length(bytes:&[u8])->Result<usize,USBError> {
+    if bytes.len()<9 {return Err(USBError::InvalidParameter);}
+    let total=u16::from_le_bytes([bytes[2],bytes[3]])as usize;
+    if total<9 {return Err(USBError::InvalidParameter);}Ok(total)
+}
+pub(crate) fn validate_configuration_chain(bytes:&[u8])->Result<(),USBError> {
+    let mut offset=0;
+    while offset<bytes.len() {
+        if bytes.len()-offset<2 {return Err(USBError::InvalidParameter);}
+        let length=bytes[offset]as usize;
+        let minimum=match bytes[offset+1] {2|4=>9,5=>7,_=>2};
+        if length<minimum || length>bytes.len()-offset {return Err(USBError::InvalidParameter);}
+        offset+=length;
+    }Ok(())
+}
