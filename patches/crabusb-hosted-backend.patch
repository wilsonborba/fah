+            Some(unsafe {DmaHandle::new(ptr,DmaAddr::from(ptr.as_ptr() as u64),layout)})
+        }
+        unsafe fn dealloc_coherent(&self,h:DmaHandle) {
+            unsafe {std::alloc::dealloc(h.as_ptr().as_ptr(),h.layout());}
+        }
+        unsafe fn map_single(&self,_:u64,_:NonNull<u8>,_:NonZeroUsize,_:usize,_:DmaDirection)->core::result::Result<DmaMapHandle,DmaError> {unreachable!()}
+        unsafe fn unmap_single(&self,_:DmaMapHandle) {unreachable!()}
+    }
+    impl KernelOp for Memory {fn delay(&self,_:Duration) {}}
+    static MEMORY:Memory=Memory;
+    #[test]
+    fn event_cycle_is_checked_before_consumption_and_wraps() {
+        let kernel=Kernel::new(u64::MAX,&MEMORY);
+        let mut ring=EventRing::new(2,&kernel).unwrap();
+        // Zeroed entries have an unpublished cycle; no dequeue advance.
+        assert!(ring.next().is_none());
+        assert_eq!((ring.segment_index,ring.trb_index,ring.cycle),(0,0,true));
+        for segment in &mut ring.segments {
+            for index in 0..TRBS_PER_SEGMENT {
+                // Command Completion TRB: type 33, Success completion, cycle one.
+                segment.trbs.set(index,super::super::ring::TrbData([0,0,1<<24,(33<<10)|1]));
+            }
+        }
+        for _ in 0..TRBS_PER_SEGMENT*2 {assert!(ring.next().is_some());}
+        assert_eq!((ring.segment_index,ring.trb_index,ring.cycle),(0,0,false));
+        assert!(ring.next().is_none()); // stale entries from previous cycle
+        ring.segments[0].trbs.set(0,super::super::ring::TrbData([0,0,1<<24,33<<10]));
+        assert!(ring.next().is_some());
+        assert!(ring.next().is_none());
+    }
+    #[test]
+    fn producer_cycle_and_link_wrap_follow_free_slot_ownership() {
+        let kernel=Kernel::new(u64::MAX,&MEMORY);
+        let mut ring=Ring::new_segment(true,DmaDirection::ToDevice,&kernel).unwrap();
+        for _ in 0..TRBS_PER_SEGMENT-1 {
+            ring.enque_command(xhci::ring::trb::command::Noop::new().into());
+        }
+        assert!(!ring.cycle);
+        assert_eq!(ring.i,0);
+        let link=ring.trbs.read(TRBS_PER_SEGMENT-1).unwrap().to_raw();
+        assert_eq!(link[3]&1,1);
+        ring.enque_command(xhci::ring::trb::command::Noop::new().into());
+        assert_eq!(ring.trbs.read(0).unwrap().to_raw()[3]&1,0);
+    }
+
+}
