+#[cfg(all(test, feature = "hosted-direct"))]
+mod hosted_tests {
+    use super::*;
+    #[test]
+    fn registration_and_dispatch_share_software_exclusion() {
+        let queues = Arc::new(IrqLock {inner: Mutex::new(()), data: UnsafeCell::new(alloc::collections::BTreeMap::new())});
+        let workers: alloc::vec::Vec<_> = (0..4).map(|_| {
+            let queues = queues.clone();
+            std::thread::spawn(move || {
+                for index in 0..10000 {
+                    let mut map = queues.lock();
+                    *map.entry(index % 16).or_insert(0usize) += 1;
+                }
+            })
+        }).collect();
+        for worker in workers { worker.join().unwrap(); }
+        assert_eq!(queues.lock().values().sum::<usize>(),40000);
+    }
+}
