+ assert_eq!(periodic_interval(Speed::Full,EndpointType::Interrupt,255,0).unwrap(),10);
+ assert_eq!(periodic_interval(Speed::Low,EndpointType::Interrupt,1,0).unwrap(),3);
+ assert!(periodic_interval(Speed::Full,EndpointType::Isochronous,0,0).is_err());
+ assert!(periodic_interval(Speed::Low,EndpointType::Isochronous,1,0).is_err());
+}}
