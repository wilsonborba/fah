+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_endpoints(interface,alternate,bytes).await
+    }
+    pub fn submit_request(&mut self,slot:u8,endpoint:u8,request:usb_if::endpoint::TransferRequest)->Result<usb_if::endpoint::RequestId> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_submit(endpoint,request)
+    }
+    pub fn request_dma_address(&mut self,slot:u8,endpoint:u8,id:usb_if::endpoint::RequestId)->Result<Option<u64>> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_request_dma(endpoint,id)
+    }
+    pub fn reclaim_request(&mut self,slot:u8,endpoint:u8,id:usb_if::endpoint::RequestId)->Result<Option<ExplicitCompletion>> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_reclaim(endpoint,id)
