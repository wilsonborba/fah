+    }
+    pub async fn set_configuration(&mut self,slot:u8,value:u8)->Result<()> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_configuration(value).await
+    }
+    pub async fn set_interface(&mut self,slot:u8,interface:u8,alternate:u8)->Result<()> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_interface(interface,alternate).await
+    }
