+        assert!(validate_configuration_chain(&config).is_ok());
+        config[9]=0;assert!(validate_configuration_chain(&config).is_err());
+        config[2]=8;assert!(checked_configuration_length(&config).is_err());
+        config[1]=1;assert!(checked_descriptor_bytes(&config,11,9,2,9).is_err());
