+/// Direct hosted entry point sharing the existing xHCI engine. Unlike the
+/// convenience Core, initialization does not discover/reset root-hub ports.
+#[cfg(feature = "hosted-direct")]
+pub struct ExplicitHost {pub(crate) core:Xhci}
+#[cfg(feature = "hosted-direct")]
+impl ExplicitHost {
+    /// # Safety
+    /// MMIO must cover all validated register/extended-capability spans and
+    /// outlive this owner and its sole event handler. Kernel/DMA resources must
+    /// remain alive through confirmed stop and successful unmap.
+    pub unsafe fn new(mmio:Mmio,kernel:&'static dyn KernelOp)->Result<Self> {
+        Ok(Self {core:Xhci::new(mmio,kernel)?})
+    }
+    pub async fn initialize(&mut self)->Result<()> {self.core.init().await}
+    pub fn port_count(&self)->u8 {self.core.reg.read().port_register_set.len() as u8}
+    /// Read only: no PORTSC W1C acknowledgment and no discovery helper.
+    pub fn port_status(&self,number:u8)->Result<u32> {
+        let reg=self.core.reg.read();
+        if number==0 || number as usize>reg.port_register_set.len() {return Err(USBError::Other(anyhow!("invalid root port")));}
+        // PORTSC is one aligned 32-bit register per 16-byte port register set.
+        // The hosted owner validated the whole port-register span before new().
+        let operational=reg.capability.caplength.read_volatile().get() as usize;
+        let ptr=(reg.mmio_base+operational+0x400+(number as usize-1)*16) as *const u32;
+        Ok(unsafe {ptr.read_volatile()})
+    }
+
+    pub fn event_handler(&mut self)->crate::EventHandler {
+        crate::EventHandler::from_inner(self.core.create_event_handler())
+    }
+}
