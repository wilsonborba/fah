+    }
+    pub async fn reset_endpoint(&mut self,slot:u8,endpoint:u8,preserve:bool)->Result<()> {
+        self.devices.get_mut(&slot).ok_or(USBError::NotFound)?.explicit_reset_endpoint(endpoint,preserve).await
